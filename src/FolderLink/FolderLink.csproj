<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FolderLink</AssemblyName>
    <!-- Must match the C# namespace (FolderLinkApp) that Strings.Designer.cs
         passes to ResourceManager: the SDK names embedded .resx resources
         <RootNamespace>.<FileName>. A mismatch here compiles fine but throws
         MissingManifestResourceException in MainForm's constructor, so the
         exe dies at launch with no window. -->
    <RootNamespace>FolderLinkApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>2.0.0</Version>
    <Product>FolderLink</Product>
    <AssemblyTitle>FolderLink</AssemblyTitle>
    <Description>移動資料夾內容並在原位置保留符號連結</Description>
    <Company>FolderLink</Company>
    <Copyright>Public domain / MIT-style, no rights reserved</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for Encoding.GetEncoding(<OEM codepage>) — .NET's built-in
         encodings don't include legacy codepages like 950 (Traditional
         Chinese Big5), which robocopy's banner/summary output uses. -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderLink.Core\FolderLink.Core.csproj" />
  </ItemGroup>

</Project>
