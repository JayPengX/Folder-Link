<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FolderLink</AssemblyName>
    <RootNamespace>FolderLink</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>2.0.0</Version>
    <Product>FolderLink</Product>
    <AssemblyTitle>FolderLink</AssemblyTitle>
    <Description>移動資料夾內容並在原位置保留符號連結</Description>
    <Company>FolderLink</Company>
    <Copyright>Public domain / MIT-style, no rights reserved</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderLink.Core\FolderLink.Core.csproj" />
  </ItemGroup>

</Project>
